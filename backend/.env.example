DATABASE_URL=postgres://postgres:postgres@localhost:5432/timio
REDIS_URL=redis://localhost:6379
PORT=8787
JWT_SECRET=change-me-in-production

# Модуль подписок (ЮKassa) - тестовые ключи берутся в личном кабинете ЮKassa
# (Настройки магазина -> API ключи). Без них платежи работать не будут
# (см. предупреждение в modules/subscriptions/yookassa.ts).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Как часто фоновый поллер проверяет истекшие триалы/продления, мс (по умолчанию 1 час)
SUBSCRIPTION_CRON_INTERVAL_MS=3600000

# Модуль реальных уведомлений (Telegram) - публичный адрес ЭТОГО API, нужен
# чтобы Telegram мог достучаться до webhook (POST /webhooks/telegram/:businessId).
# В локальной разработке (localhost) оставьте пустым - webhook просто не
# зарегистрируется, но остальной функционал (отправка через уже привязанный
# чат) не пострадает.
PUBLIC_API_BASE_URL=
# Как часто воркер проверяет очередь "созревших" напоминаний, мс (по умолчанию 1 минута)
REMINDER_WORKER_INTERVAL_MS=60000
